{
  "bug-vet-local-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/guard_local_only.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bug-vet-probe-vacuity-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|multi_edit_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/guard_probe_vacuity.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
